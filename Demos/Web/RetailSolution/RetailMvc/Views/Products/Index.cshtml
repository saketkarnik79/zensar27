@model IEnumerable<RetailMvc.Models.Product>

<h2>Product List</h2>

<a asp-action="Create">Add Product</a>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Price</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.Id</td>
                <td>@product.Name</td>
                <td>@product.Price</td>
                <td>
                    <a asp-action="Details"
                       asp-route-id="@product.Id">
                        Details
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>