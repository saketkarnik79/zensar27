<h2>Monthly Sales Dashboard</h2>

<canvas id="salesChart"></canvas>

@section Scripts
{
    <script src="~/lib/chartjs/chart.umd.min.js">
    </script>

    <script>

        const ctx = document.getElementById("salesChart");

        new Chart(ctx, {

            type: "bar",

            data: {
                labels: [
                    "January",
                    "February",
                    "March",
                    "April",
                    "May"
                ],

                datasets: [{
                    label: "Monthly Sales",
                    data: [
                        25000,
                        40000,
                        35000,
                        55000,
                        65000
                    ],
                    backgroundColor: "steelblue"
                }]
            },

            options: {
                responsive: true
            }

        });

    </script>
}