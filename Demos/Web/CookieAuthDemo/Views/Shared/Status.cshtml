@{
    ViewData["Title"] = "Error";
}

<div class="text-center mt-5">

    <h1 class="display-1 text-danger">
        @ViewBag.StatusCode
    </h1>

    <h3>@ViewBag.ErrorMessage</h3>

    <p>
        Requested URL: @ViewBag.OriginalPath
    </p>

    <a asp-controller="Home"
       asp-action="Index"
       class="btn btn-primary">

        Return to Home

    </a>

</div>